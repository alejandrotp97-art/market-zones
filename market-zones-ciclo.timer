[Unit]
Description=Foto semanal del ciclo economico (domingo por la manana)

[Timer]
# Una vez a la semana, decision del usuario (2026-10-18): el ciclo se mueve en
# meses y el CLI de la OCDE es mensual; una foto semanal basta y no cambia de
# fase cada vez que se abre el panel. Domingo 07:30 hora de MADRID (el servidor
# va en UTC; con la zona escrita aqui el cambio de hora no la mueve). Va antes
# del catalogo (08:20) para no coincidir con el.
OnCalendar=Sun *-*-* 07:30 Europe/Madrid
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
